# build_code_sha256() and runtime_code_sha256() hash these files byte for byte
# and the release chain compares those hashes across machines.  Without a fixed
# end-of-line, a Windows checkout (core.autocrlf=true) and a Linux checkout of
# the same commit produce different hashes, and an otherwise valid release
# refuses to activate.
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.lock text eol=lf

# PowerShell helpers stay in the platform convention; nothing hashes them.
*.ps1 text eol=crlf
