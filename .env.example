# NoneBot 同时需要 HTTP 服务端（接收 NapCat 事件）和 HTTP 客户端（调用 NapCat API）
DRIVER=~fastapi+~httpx
HOST=0.0.0.0
PORT=8080

# key 必须替换为机器人 QQ；NapCat HTTP API 在同一 Docker 网络内使用服务名访问
ONEBOT_V11_API_ROOTS={"机器人QQ":"http://napcat:3000"}
# 必须设置，并与 NapCat 新增 HTTP Client 的 token 完全一致；不要使用示例值
ONEBOT_V11_ACCESS_TOKEN=replace-me

LUNA_RELEASE_ROOT=/app/releases
# 大连理工大学大模型网关；四个角色统一走同一 OpenAI 兼容入口
LUNA_MODEL_BASE_URL=http://aigw.dlut.edu.cn/v1
LUNA_MODEL_API_KEY=replace-me
LUNA_PLANNER_MODEL=Qwen3.5-9B
LUNA_EMBEDDING_MODEL=bge-m3
LUNA_EMBEDDING_DIMENSION=1024
LUNA_RERANKER_MODEL=Qwen3-Reranker-8B
LUNA_RERANKER_URL=http://aigw.dlut.edu.cn/v1/rerank
LUNA_RERANK_MIN_SCORE=0.35
LUNA_ANSWER_MODEL=Qwen3.5-35B-A3B
# draft 允许自然改写并标记待人工复核；strict 仅用于审计回归
LUNA_ANSWER_MODE=draft
LUNA_ANSWER_MAX_CHARS=300
LUNA_ANSWER_MAX_SOURCES=3
# 简单单一问句跳过 Planner；复杂/上下文问题仍走 Planner
LUNA_FAST_PATH_ENABLED=true
LUNA_REQUEST_TIMEOUT=8

# 逗号分隔；留空会拒绝启动答疑逻辑
LUNA_ALLOWED_GROUP_IDS=123456789
LUNA_HISTORY_TURNS=3
LUNA_HISTORY_TTL_SECONDS=1800
LUNA_HISTORY_MAX_CONVERSATIONS=2048
LUNA_MESSAGE_DEDUPE_SECONDS=600
LUNA_MESSAGE_DEDUPE_MAX_ENTRIES=4096
LUNA_USER_COOLDOWN_SECONDS=3
LUNA_ANSWER_CONCURRENCY=2
LUNA_ANSWER_QUEUE_SIZE=50
LUNA_ANSWER_CACHE_TTL_SECONDS=300
LUNA_ANSWER_CACHE_SIZE=256
LUNA_MAX_QUESTION_CHARS=500
LUNA_ANSWER_QUEUE_TIMEOUT_SECONDS=30
LUNA_ANSWER_TOTAL_TIMEOUT_SECONDS=15
LUNA_OOM_SCORE_ADJ=500

# Compose 只加入现有网络，不创建或替换 NapCat
NAPCAT_NETWORK=qq-mc-bridge_default
CAMPUS_QA_RELEASES_PATH=./releases
